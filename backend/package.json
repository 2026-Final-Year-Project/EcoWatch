{
  "name": "ecowatch-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --env-file-if-exists=.env --watch src/server.js",
    "start": "node --experimental-sqlite --env-file-if-exists=.env src/server.js",
    "db:init": "node --experimental-sqlite --env-file-if-exists=.env src/database/manage.js init",
    "db:check": "node --experimental-sqlite --env-file-if-exists=.env src/database/manage.js check",
    "db:backup": "node --experimental-sqlite --env-file-if-exists=.env src/database/manage.js backup",
    "db:user": "node --experimental-sqlite --env-file-if-exists=.env src/database/manage.js user",
    "test": "node --experimental-sqlite --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
